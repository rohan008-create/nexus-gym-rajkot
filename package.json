    "check:explosion": "node scripts/test-explosion.cjs",
    "check:entrance": "node scripts/test-entrance.cjs",
    "check:fracture": "node scripts/test-fracture.cjs",
    "check:advantage": "node scripts/test-advantage.cjs",
    "assets:advantage": "node scripts/prepare-advantage.cjs",
    "check:trainers": "node scripts/test-trainers.cjs",
