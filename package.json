    "build": "next build",
    "copy:cesium": "node scripts/copy-cesium.cjs",
    "start": "next start",
    "lint": "next lint",
    "check:hero": "node scripts/test-iron-world.cjs",
    "check:armory": "node scripts/test-armory.cjs",
