    "pack:evolution": "node scripts/pack-evolution.cjs",
    "check:evolution-smoothness": "node scripts/test-evolution-smoothness.cjs",
    "check:booking": "node scripts/test-booking-utils.cjs && node scripts/test-booking.cjs",
