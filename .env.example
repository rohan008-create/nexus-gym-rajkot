# Set only the verified official NEXUS WhatsApp destination, with country code.
# Digits only; do not use a sample number. Restart/rebuild after changing it.
NEXT_PUBLIC_NEXUS_WHATSAPP_NUMBER=
NEXT_PUBLIC_NEXUS_WHATSAPP_DEMO=false
# Set the real public website URL after hosting, for canonical and sharing URLs.
NEXT_PUBLIC_SITE_URL=
